# Fastfetch
abbr ff fastfetch

# clear
abbr c clear

# Neovim
abbr --add vim nvim

# Shell
abbr --add f "nvim $HOME/.config/fish/config.fish"

# Hyprland
abbr --add h "nvim $HOME/.config/hypr/hyprland.lua"
abbr --add a "nvim $HOME/.config/hypr/hyprland/animations.lua"
abbr --add g "nvim $HOME/.config/hypr/hyprland/generals.lua"
abbr --add i "nvim $HOME/.config/hypr/hyprland/input.lua"
abbr --add k "nvim $HOME/.config/hypr/hyprland/keybinds.lua"
abbr --add r "nvim $HOME/.config/hypr/hyprland/rules.lua"
abbr --add m "nvim $HOME/.config/hypr/hyprland/monitor.lua"
abbr --add ex "nvim $HOME/.config/hypr/hyprland/execs.lua"
abbr --add en "nvim $HOME/.config/hypr/hyprland/env.lua"

# Terminal
abbr --add kc "nvim $HOME/.config/kitty/kitty.conf"
abbr --add gt "nvim $HOME/.config/ghostty/config.ghostty"

# Launchers
abbr --add fz "nvim $HOME/.config/fuzzel/fuzzel.ini"
abbr --add rr "nvim $HOME/.config/rofi/config.rasi"