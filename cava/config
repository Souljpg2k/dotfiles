[general]
live-config = 1
mode = normal
framerate = 60
autosens = 1
bars = 0
bar_width = 3
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit

[color]
theme = 'matugen'

[smoothing]
integral = 77
noise_reduction = 80

[eq]
1 = 1 # bass
2 = 1
3 = 1 # midtone
4 = 1
5 = 1 # treble